<controls:SafeWindow x:Class="FloatingX.FloatingSettingsWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Cvte.Windows.Controls;assembly=Cvte.Windows.cc"
    Title="悬浮窗设置中心" Width="720" Height="830" MinWidth="640" MinHeight="540"
    FontFamily="Microsoft YaHei UI" FontSize="13" ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}"
    Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <controls:SafeWindow.Resources>
        <SolidColorBrush x:Key="Accent" Color="#00B982"/>
        <SolidColorBrush x:Key="AccentHover" Color="#00A775"/>
        <SolidColorBrush x:Key="Ink" Color="#24332E"/>
        <SolidColorBrush x:Key="Muted" Color="#78847F"/>
        <SolidColorBrush x:Key="Line" Color="#E7ECE9"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F7F6"/>
        <BooleanToVisibilityConverter x:Key="Shown"/>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#D5DDD8" CornerRadius="4" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.26"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Arrow" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="48" Height="34" Background="Transparent">
                        <Border x:Name="Track" Height="24" CornerRadius="12" Background="#CFD8D3"/>
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </controls:SafeWindow.Resources>
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#E9F3EE" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="排列预览" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21" Background="#661F2122" Margin="0,0,10,0"><Image Source="{Binding AnchorIcon}" Width="30" Height="30" Stretch="Uniform"/></Border>
                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#661F2122" Margin="0,5,7,5" ToolTip="{Binding Label}" Visibility="{Binding IsShown, Converter={StaticResource Shown}}"><Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"/></Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyHint" Text="保留设置入口" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
            <DockPanel Margin="16,12,12,8">
                <Grid DockPanel.Dock="Top" Margin="2,0,4,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="按钮与顺序" FontWeight="SemiBold"/><TextBlock x:Name="VisibleCount" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/></StackPanel>
                    <Button Content="恢复默认" Click="Reset" HorizontalAlignment="Right" Style="{StaticResource Button}" Padding="10,5" FontSize="12"/>
                </Grid>
                <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewDragOver="ScrollWhileDragging">
                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border x:Name="Row" CornerRadius="8" Padding="8,5" Margin="0,1,4,1" Background="Transparent" BorderThickness="0,2,0,2" BorderBrush="Transparent" AllowDrop="True" DragOver="DragOverRow" DragLeave="DragLeaveRow" Drop="DropOnRow">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <Grid Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="BeginReorder" PreviewMouseMove="ContinueReorder" ToolTip="拖动排序" AutomationProperties.Name="{Binding Label, StringFormat=拖动排序{0}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Path Data="M 4,5 A 1,1 0 1 0 4,7 A 1,1 0 1 0 4,5 M 10,5 A 1,1 0 1 0 10,7 A 1,1 0 1 0 10,5 M 4,11 A 1,1 0 1 0 4,13 A 1,1 0 1 0 4,11 M 10,11 A 1,1 0 1 0 10,13 A 1,1 0 1 0 10,11 M 4,17 A 1,1 0 1 0 4,19 A 1,1 0 1 0 4,17 M 10,17 A 1,1 0 1 0 10,19 A 1,1 0 1 0 10,17" Fill="#AAB5AF" Width="14" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="#661F2122" HorizontalAlignment="Left"><Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"/></Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0"><TextBlock Text="{Binding Label}" FontWeight="Medium"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="MoveUp" Style="{StaticResource Arrow}" IsEnabled="{Binding CanMoveUp}" ToolTip="上移" AutomationProperties.Name="{Binding Label, StringFormat=上移{0}}"><Path Data="M 1,7 L 6,2 L 11,7" Stroke="{DynamicResource Ink}" StrokeThickness="1.6"/></Button>
                                        <Button Click="MoveDown" Style="{StaticResource Arrow}" IsEnabled="{Binding CanMoveDown}" ToolTip="下移" AutomationProperties.Name="{Binding Label, StringFormat=下移{0}}"><Path Data="M 1,3 L 6,8 L 11,3" Stroke="{DynamicResource Ink}" StrokeThickness="1.6"/></Button>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsShown, Mode=TwoWay}" Style="{StaticResource Switch}" HorizontalAlignment="Right" ToolTip="显示或隐藏按钮" AutomationProperties.Name="{Binding Label, StringFormat=显示{0}}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Canvas}"/></Trigger></DataTemplate.Triggers>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <TextBlock Text="空白白板授课" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="打开白板" Click="OpenWhiteboard" Style="{StaticResource Button}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel" IsCancel="True" Style="{StaticResource Button}" Margin="0,0,10,0" MinWidth="80"/>
            <Button Content="保存并应用" Click="Save" IsDefault="True" Style="{StaticResource Primary}" MinWidth="120"/>
        </StackPanel>
    </Grid>
</controls:SafeWindow>
